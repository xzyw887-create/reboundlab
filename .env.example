# === Application ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@backtestpro.ru
NEXT_PUBLIC_TELEGRAM_KIND=group
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/backtestpro_help
NEXT_PUBLIC_TELEGRAM_HANDLE=@BackTestPro_Help
# Split landing (Vercel) vs app (Render) — optional
NEXT_PUBLIC_FULL_APP_URL=

# === Database (PostgreSQL + TimescaleDB) ===
DATABASE_URL=postgresql://reboundlab:reboundlab@localhost:5432/reboundlab
DATABASE_POOL_SIZE=10

# === Redis ===
REDIS_URL=redis://localhost:6379

# === Auth ===
JWT_SECRET=change-me-in-production-min-32-chars
# Server-only: ручное удаление аккаунтов и подарок тарифа (GET/POST/DELETE /api/admin/user)
# ADMIN_API_SECRET=generate-long-random-string-never-commit-real-value

# Тест оплаты: карточки на /pricing — как в subscriptionTiers; к списанию (checkout / ЮKassa) — 100 ₽
# BILLING_CHARGE_BASIC_RUB=100
# BILLING_CHARGE_PRO_RUB=100
# NEXT_PUBLIC_BILLING_CHARGE_BASIC_RUB=100
# NEXT_PUBLIC_BILLING_CHARGE_PRO_RUB=100
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Optional: separate secret for signup device hashing (defaults to JWT_SECRET)
# SIGNUP_GUARD_SECRET=
# Set 1 to allow multiple registrations per browser (dev only)
# SIGNUP_GUARD_DISABLED=1

# Local dev: Pro limits + login without Telegram (localhost only)
# DEV_LOCAL_AUTH=1
# NEXT_PUBLIC_DEV_LOCAL_AUTH=1
# NEXT_PUBLIC_LOCAL_TEST_MODE=1

# Временно: email+пароль на /login (проверка ЮKassa) — потом оба флага убрать
# EMAIL_PASSWORD_AUTH=1
# NEXT_PUBLIC_EMAIL_PASSWORD_AUTH=1

# === Telegram Login Widget (BotFather → /setdomain your-domain) ===
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotNameBot

# === Market Data ===
BINANCE_API_URL=https://fapi.binance.com
BYBIT_API_URL=https://api.bybit.com
MARKET_DATA_SYNC_INTERVAL_MS=60000
MARKET_DATA_MIN_HISTORY_DAYS=365

# === Backtester ===
BACKTESTER_MAX_CONCURRENT_JOBS=4
BACKTESTER_JOB_TIMEOUT_MS=300000

# === Payments (Phase 3) ===
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# === Email (Phase 3) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# === Monitoring ===
SENTRY_DSN=
