# Production web: Next.js + Python backtester
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json turbo.json ./
COPY apps/web/package.json apps/web/
COPY backtester/requirements.txt backtester/

RUN npm ci --include-workspace-root

RUN pip3 install --no-cache-dir -r backtester/requirements.txt --break-system-packages

COPY . .

ENV NODE_ENV=production
ENV PROJECT_ROOT=/app
ENV HOSTNAME=0.0.0.0

# NEXT_PUBLIC_* must exist at build time (baked into client JS)
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
ARG NEXT_PUBLIC_APP_URL=https://backtestpro.ru
ENV NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=$NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

RUN npm run web:build

# Railway injects PORT (usually 8080). Run Next from apps/web where .next lives.
WORKDIR /app/apps/web
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 8080

CMD ["sh", "-c", "exec npx next start -H 0.0.0.0 -p ${PORT:-8080}"]
