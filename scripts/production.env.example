# Production environment — copy values to Railway / Render / Fly
# NEVER commit real secrets to git

NODE_ENV=production
PROJECT_ROOT=/app

POSTGRES_PASSWORD=длинный_случайный_пароль
# Sprinthost (docker-compose.prod): достаточно POSTGRES_PASSWORD + JWT_SECRET
# Timeweb/Neon отдельная БД:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=
# Длинный случайный секрет — только на VPS, для scripts/admin-user.sh
# ADMIN_API_SECRET=

# Тест друзьям: списание 100 ₽ (карточки на сайте можно не менять). После теста — удалить строки.
# BILLING_CHARGE_BASIC_RUB=100
# BILLING_CHARGE_PRO_RUB=100
# NEXT_PUBLIC_BILLING_CHARGE_BASIC_RUB=100
# NEXT_PUBLIC_BILLING_CHARGE_PRO_RUB=100

# ЮKassa (личный кабинет → Интеграция → ключи API)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Webhook в кабинете: https://backtestpro.ru/api/billing/yookassa/webhook
# События: payment.succeeded
# YOOKASSA_RETURN_URL=https://backtestpro.ru/pricing
# YOOKASSA_SEND_RECEIPT=1

# Public site URL (password reset links, metadata)
NEXT_PUBLIC_APP_URL=https://backtestpro.ru

# Support (footer, /help, /terms) — лучше доменная почта, не личная mail.ru
NEXT_PUBLIC_SUPPORT_EMAIL=support@backtestpro.ru
# Telegram: группа или канал (ссылка t.me/...) — личный @ только если готовы к личным сообщениям
NEXT_PUBLIC_TELEGRAM_KIND=group
# Если ссылка-приглашение (t.me/+...), вставьте её в URL; | в названии группы в URL не бывает
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/backtestpro_help
NEXT_PUBLIC_TELEGRAM_HANDLE=@BackTestPro_Help

# Письма (сброс пароля) — почта на домене REG.RU или Yandex для домена
SMTP_HOST=mail.hosting.reg.ru
SMTP_PORT=587
SMTP_USER=support@backtestpro.ru
SMTP_PASS=
MAIL_FROM=support@backtestpro.ru
# Optional: separate app host (split landing vs app — advanced)
# NEXT_PUBLIC_FULL_APP_URL=

# Do NOT set in production (dev only):
# NEXT_PUBLIC_LOCAL_TEST_MODE=1
